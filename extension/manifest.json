{
  "manifest_version": 3,
  "name": "Scam Detector",
  "version": "1.1",
  "description": "Flags financial scam posts on Instagram, Facebook and X.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["lib/html2canvas.min.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
